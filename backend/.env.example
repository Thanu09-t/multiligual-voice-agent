# ==========================================
# NOVA Voice Agent - Environment Configuration
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# Defaults to SQLite for immediate local zero-friction setup, or PostgreSQL for production:
# PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/nova
# SQLite: sqlite+aiosqlite:///./nova.db
DATABASE_URL=sqlite+aiosqlite:///./nova.db

# Security & Authentication
JWT_SECRET=super-secret-nova-development-key-change-in-production-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Keys
# LLM Provider (openai | groq | gemini | mock)
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# STT Provider (whisper | groq | mock)
STT_PROVIDER=mock
STT_API_KEY=

# TTS Provider (edge_tts | openai | mock)
TTS_PROVIDER=mock
TTS_API_KEY=
DEFAULT_VOICE=en-US-JennyNeural
SPEECH_SPEED=1.0

# External Tools
WEATHER_API_KEY=
# Web Search Provider: duckduckgo (free, no key) | tavily | serper
# Get a Tavily key at: https://tavily.com (free tier: 1000 queries/month)
# Get a Serper key at: https://serper.dev (free tier: 2500 queries)
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Voice Activity Detection (VAD) Defaults
VAD_ENERGY_THRESHOLD=0.02
VAD_SILENCE_TIMEOUT_MS=800
